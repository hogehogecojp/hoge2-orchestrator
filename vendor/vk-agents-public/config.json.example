{
  "multi_repo_task": {
    "default_engine": "codex"
  },
  "agents": {
    "default_engine": "claude",
    "engine": {
      "vk-wp-developer": "claude",
      "vk-ui-tester": "claude"
    }
  },
  "features": {
    "coderabbit": true,
    "coderabbit_ignore": false,
    "task_queue": true
  },
  "skills": {
    "disabled": []
  },
  "org": {
    "allowed_owners": ["vektor-inc"],
    "review_assets_repo": "vektor-inc/review-assets"
  },
  "workspace": {
    "search_paths": [
      "~/Documents/git"
    ]
  }
}
